{
  "firestore": {
    "rules": "firestore.readonly.rules"
  },
  "hosting": [
    {
      "site": "myhappa",
      "public": "public",
      "redirects": [
        {
          "source": "/",
          "destination": "https://bahi-happa.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://bahi-happa.web.app/:path",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31556926; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
            }
          ]
        }
      ]
    },
    {
      "site": "happaapp",
